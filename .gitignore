# Virtual environment
.venv/
venv/

# Environment variables (contains machine-specific paths, never secrets by design,
# but still shouldn't be committed since it documents a specific local setup)
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local persistent data (regenerated by the app, not source)
data/chroma_db/
data/metadata.db
data/cache/
data/audio/
data/documents/

# Downloaded local models (large binaries; users pull these themselves)
*.gguf
*.onnx
*.bin
models/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
