# =============================================================================
# Document Assistant - Environment Configuration
# Copy this file to ".env" and adjust values for your machine.
# Nothing in this file is a secret; there are no cloud API keys required.
# =============================================================================

# --- Backend server ---
# Bind to localhost only. This is a single-user local app, not multi-user auth.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- LLM provider ---
# Use "ollama" for local development or "huggingface" for Hugging Face Inference Providers.
LLM_PROVIDER=ollama
# Ollama settings (used when LLM_PROVIDER=ollama; Ollama runs separately).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Max tokens Ollama is allowed to generate per answer.
OLLAMA_MAX_OUTPUT_TOKENS=512
# Roughly how many tokens of retrieved evidence we allow into the prompt.
OLLAMA_CONTEXT_BUDGET_TOKENS=3000
# Hugging Face settings (used when LLM_PROVIDER=huggingface).
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Keep this blank locally; configure HF_TOKEN as a Space secret for deployment.
HF_TOKEN=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage paths (created automatically, relative to project root) ---
CHROMA_DB_PATH=./data/chroma_db
SQLITE_DB_PATH=./data/metadata.db
CACHE_DIR=./data/cache
AUDIO_DIR=./data/audio

# --- Chunking / retrieval ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=8

# --- Ingestion limits ---
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_EXTRACTIONS=2

# --- OCR (optional fallback for scanned PDFs) ---
OCR_ENABLED=false
TESSERACT_CMD=

# --- Voice input (speech-to-text) ---
WHISPER_MODEL_SIZE=small
# cpu is required on this target machine (no dedicated GPU)
WHISPER_DEVICE=cpu

# --- Voice output (text-to-speech) ---
TTS_ENABLED=false
TTS_VOICE=en_US-lessac-medium
