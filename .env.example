# =============================================================================
# Document Assistant - Environment Configuration
# Copy this file to ".env" and adjust values. Never commit ".env".
# =============================================================================

# --- Backend server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Render sets PORT automatically. Do not hardcode it.
# PORT=8000

# Optional browser CORS (comma-separated). Streamlit server-side calls do
# not need this. Leave blank unless a browser will call the API directly.
CORS_ORIGINS=

# Streamlit: set this to the Render URL when the backend is a separate process.
# Example: https://document-assistant-api.onrender.com
# Leave blank for local in-process Streamlit (TestClient).
BACKEND_URL=

# --- LLM provider: ollama | huggingface | openai ---
# Use openai on Render. Ollama is not available after deployment.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Local Ollama (ignored when LLM_PROVIDER=openai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_CONTEXT_BUDGET_TOKENS=3000

# Hugging Face (optional alternative to OpenAI)
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_TOKEN=

# Local embedding model name (only when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage paths (ephemeral on Render free: wiped on restart/sleep) ---
CHROMA_DB_PATH=./data/chroma_db
SQLITE_DB_PATH=./data/metadata.db
CACHE_DIR=./data/cache
AUDIO_DIR=./data/audio

CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=8

MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_EXTRACTIONS=2

# OCR needs Tesseract + Poppler on the host. Off by default on Render.
OCR_ENABLED=false
TESSERACT_CMD=

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

TTS_ENABLED=false
TTS_VOICE=en_US-lessac-medium
